{
  "name": "dsh-desktop",
  "productName": "DSH-Desktop",
  "version": "0.2.7-rc.7",
  "description": "Cross-platform desktop app for DeepSeek Harness, powered by Electron",
  "author": {
    "name": "wang48",
    "email": "wangyanpeng03@gmail.com"
  },
  "private": true,
  "main": "src/main.cjs",
  "license": "MIT",
  "homepage": "https://github.com/wang48/dsh-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang48/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/wang48/dsh-desktop/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "electron",
    "desktop-app",
    "ai-agent"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "gen:icon": "node scripts/gen-icon.mjs",
    "patch": "node scripts/patch-picker-worker.mjs && node scripts/patch-acl-runner-window.mjs && node scripts/patch-secure-context.mjs && node scripts/patch-mac-keychain.mjs && node scripts/patch-builder-peers.mjs",
    "postinstall": "npm run patch",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "npm run check:syntax && npm test",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-spill": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-workflow": "^0.1.5-rc.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.0"
  },
  "build": {
    "appId": "com.deepseek.dsh.desktop",
    "productName": "DSH-Desktop",
    "publish": {
      "provider": "github",
      "owner": "wang48",
      "repo": "dsh-desktop"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-Desktop"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
